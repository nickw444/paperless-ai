# Paperless-AI environment configuration example

# Paperless-ngx Configuration
# Required: URL of your Paperless-ngx instance (without trailing slash)
PAPERLESS_URL=https://your-paperless-instance.com
# Required: API token from your Paperless user profile
PAPERLESS_API_TOKEN=your-api-token

# Codex CLI configuration
CODEX_COMMAND=codex # Optional: Path to Codex CLI if not in PATH
CODEX_MODEL=gpt-5
CODEX_TIMEOUT=120
CODEX_MAX_CONTENT_CHARS=2000
CODEX_REASONING_EFFORT=minimal

# Processing
# Optional: delay between document analyses in seconds. 0 disables delay.
# Default: 0
PROCESSING_DELAY_BETWEEN_DOCUMENTS_SECONDS=0

# Protected tags
# Optional: comma-separated tag names that should never be removed from documents
# Default: Inbox
PROTECTED_TAGS=Inbox,From Email,Tax Deduction

# Processing metadata
# Optional: user-defined version written to Paperless custom fields for future backfills
# Default: 1
PAPERLESS_AI_PROCESSING_VERSION=v1
